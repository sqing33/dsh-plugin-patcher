{
  "name": "dsh-plugin-patcher",
  "version": "0.1.0",
  "description": "Declarative patcher for DeepSeek Harness: rewrites settings namespaces, profile patch rows, and other plugins' package files from one spec, with drift detection and per-patch rollback.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "plugin-patcher",
    "patch",
    "drift",
    "rollback",
    "typescript",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqing33/dsh-plugin-patcher.git"
  },
  "bugs": {
    "url": "https://github.com/sqing33/dsh-plugin-patcher/issues"
  },
  "homepage": "https://github.com/sqing33/dsh-plugin-patcher#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "verify": "node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm run build && pnpm test && pnpm run verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm-pi-ai": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "author": "",
  "dependencies": {
    "yaml": "2.9.1"
  }
}
